# elogind system-sleep hook for tccd: stop the daemon before suspend and
# start it again after resume, so hardware settings (fan profiles, CPU
# limits, charging thresholds) are re-applied on wake.
# OpenRC equivalent of upstream's systemd unit tccd-sleep.service.
#
# Called by elogind as: <script> pre|post suspend|hibernate|hybrid-sleep|suspend-then-hibernate

case "$1" in
    pre)
        /sbin/rc-service --ifstarted tccd stop || true
        ;;
    post)
        /sbin/rc-service --ifnotstarted tccd start || true
        ;;
esac

exit 0
